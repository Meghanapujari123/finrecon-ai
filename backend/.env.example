# Copy this file to .env and fill in real values. Never commit .env.

# App
APP_NAME=FinRecon AI
ENV=development
LOG_LEVEL=INFO

# Database. Local/dev default is SQLite (zero setup). Docker Compose sets
# this to a Postgres URL instead - see docker-compose.yml.
DATABASE_URL=sqlite:///./finrecon.db
# Example Postgres URL:
# DATABASE_URL=postgresql+psycopg2://finrecon:finrecon@localhost:5432/finrecon

# CORS - comma separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM provider. Set LLM_PROVIDER=none to explicitly run without AI features
# (the system is designed to keep working with degraded AI features either
# way - this just skips the "is a key configured" check).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.6-flash

GEMINI_API_KEY=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_REQUEST_TIMEOUT_SECONDS=30

# Reconciliation tuning
DATE_TOLERANCE_DAYS=2
AMOUNT_MISMATCH_THRESHOLD=1.0
FUZZY_MATCH_MIN_CONFIDENCE=0.75

# Uploads
MAX_UPLOAD_SIZE_MB=10
MAX_UPLOAD_ROWS=20000
